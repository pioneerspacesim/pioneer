## Fullscreen composite of the mask pass onto the main framebuffer.
## Mask texture R = shadow depth, G = shadow strength.

Shader ground_shadow_composite

Texture sampler2D texture0 name=shadowMask

PushConstant float shadowAlpha
PushConstant float depthBias

Buffer DrawData binding=1

Vertex "ground_shadow_composite.vert"
Fragment "ground_shadow_composite.frag"
